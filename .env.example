# 任意 OpenAI 兼容接口
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=qwen3.8-max

# Agent 运行参数
LLM_TIMEOUT_SECONDS=60
# 温度与输出上限；留空表示不发送该参数（兼容不支持这些参数的模型）
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
# 开启后发送 response_format={"type": "json_object"}；部分兼容服务不支持
LLM_JSON_MODE=false

TOOL_TIMEOUT_SECONDS=10
TOOL_OBSERVATION_MAX_CHARS=2000
OBSERVATION_PROMPT_CHARS=600
MAX_TOOL_CALLS=8
MAX_LLM_CALLS_PER_TURN=10
MAX_COMPRESSION_CALLS_PER_TURN=1
MAX_PARSE_REPAIRS=2
CONTEXT_TOKEN_BUDGET=6000
TOKEN_SAFETY_FACTOR=1.2
SUMMARY_MAX_TOKENS=512
MAX_HISTORY_MESSAGES=40
KEEP_RECENT_MESSAGES=8
SUMMARY_MAX_CHARS=800
TRACE_MAX_CHARS=2000
DATA_DIR=./data
